import { useEffect, useState } from "react";
import { useAuth } from "../../contexts/AuthContext";
import { listStudentsForAttendance } from "../../services/attendance";
import { listTerms, listSessions } from "../../services/academic";
import { getSchoolAcademicSelection } from "../../services/schoolAcademic";
import {
  ResultScore,
  listMyResultClasses,
  listMyResultSubjects,
  listResultsForEntry,
  saveScore,
  submitResults
} from "../../services/results";
import { Card } from "../../components/ui/Card";
import { Button } from "../../components/ui/Button";

export default function ResultsEntryPage() {
  const { profile } = useAuth();

  const [classes, setClasses] = useState<any[]>([]);
  const [subjects, setSubjects] = useState<any[]>([]);
  const [terms, setTerms] = useState<any[]>([]);
  const [sessions, setSessions] = useState<any[]>([]);

  const [classId, setClassId] = useState("");
  const [subjectId, setSubjectId] = useState("");
  const [termId, setTermId] = useState("");
  const [schoolSessionId, setSchoolSessionId] = useState("");

  const [students, setStudents] = useState<any[]>([]);
  const [scores, setScores] =
    useState<Record<string, Partial<ResultScore>>>({});

  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [message, setMessage] = useState<string | null>(null);

  /*
   * ============================================================
   * LOAD CLASSES / TERMS / SESSIONS
   * ============================================================
   */

  useEffect(() => {
    async function load() {
      if (!profile?.school_id) return;

      setLoading(true);
      setMessage(null);

      try {
        const [
          resultClasses,
          termList,
          sessionList,
          academicSelection
        ] = await Promise.all([
          listMyResultClasses(),
          listTerms(),
          listSessions(),
          getSchoolAcademicSelection(profile.school_id)
        ]);

        setClasses(resultClasses || []);
        setTerms(termList || []);
        setSessions(sessionList || []);

        const selectedSession =
          academicSelection?.current_session_id ||
          sessionList?.find((x: any) => x.is_current)?.id ||
          "";

        setSchoolSessionId(selectedSession);

        if (resultClasses?.length) {
          setClassId((current) =>
            current &&
            resultClasses.some(
              (item: any) => item.id === current
            )
              ? current
              : resultClasses[0].id
          );
        }

        const selectedTerm =
          academicSelection?.current_term_id ||
          termList?.find((x: any) => x.is_current)?.id ||
          termList?.[0]?.id ||
          "";

        setTermId(selectedTerm);
      } catch (error: any) {
        console.error(
          "Results entry loading error:",
          error
        );

        setMessage(
          error?.message ||
            "Unable to load result-entry information."
        );
      } finally {
        setLoading(false);
      }
    }

    load();
  }, [profile?.school_id]);

  /*
   * ============================================================
   * LOAD SUBJECTS FOR SELECTED CLASS
   * ============================================================
   */

  useEffect(() => {
    if (!classId) {
      setSubjects([]);
      setSubjectId("");
      return;
    }

    async function loadSubjects() {
      try {
        setMessage(null);

        const subjectList =
          await listMyResultSubjects(classId);

        setSubjects(subjectList || []);

        setSubjectId((current) => {
          if (
            current &&
            subjectList?.some(
              (subject: any) =>
                subject.id === current
            )
          ) {
            return current;
          }

          return subjectList?.[0]?.id || "";
        });
      } catch (error: any) {
        console.error(
          "Result subjects loading error:",
          error
        );

        setSubjects([]);
        setSubjectId("");

        setMessage(
          error?.message ||
            "Unable to load subjects for this class."
        );
      }
    }

    loadSubjects();
  }, [classId]);

  /*
   * ============================================================
   * LOAD STUDENTS + EXISTING RESULTS
   * ============================================================
   */

  useEffect(() => {
    if (!classId || !subjectId || !termId) {
      setStudents([]);
      setScores({});
      return;
    }

    async function loadResults() {
      try {
        setLoading(true);
        setMessage(null);

        const [
          studentList,
          existing
        ] = await Promise.all([
          listStudentsForAttendance(classId),
          listResultsForEntry(
            classId,
            subjectId,
            termId
          )
        ]);

        setStudents(studentList || []);

        const byStudent:
          Record<string, Partial<ResultScore>> = {};

        (studentList || []).forEach(
          (student: any) => {
            byStudent[student.id] = {
              assignment_score: 0,
              classwork_score: 0,
              ca_score: 0,
              exam_score: 0,
              teacher_comment: "",
              status: "draft"
            };
          }
        );

        (existing || []).forEach(
          (result: ResultScore) => {
            byStudent[result.student_id] =
              result;
          }
        );

        setScores(byStudent);
      } catch (error: any) {
        console.error(
          "Results loading error:",
          error
        );

        setStudents([]);
        setScores({});

        setMessage(
          error?.message ||
            "Unable to load results for this class, subject and term."
        );
      } finally {
        setLoading(false);
      }
    }

    loadResults();
  }, [classId, subjectId, termId]);

  /*
   * ============================================================
   * UPDATE SCORE
   * ============================================================
   */

  function update(
    studentId: string,
    field: keyof ResultScore,
    value: string
  ) {
    setScores((current) => ({
      ...current,
      [studentId]: {
        ...current[studentId],
        [field]:
          field === "teacher_comment"
            ? value
            : Number(value) || 0
      }
    }));
  }

  /*
   * ============================================================
   * TOTAL
   * ============================================================
   */

  function total(score: Partial<ResultScore>) {
    return (
      (Number(score.assignment_score) || 0) +
      (Number(score.classwork_score) || 0) +
      (Number(score.ca_score) || 0) +
      (Number(score.exam_score) || 0)
    );
  }

  /*
   * ============================================================
   * GET CURRENT ACADEMIC SESSION
   * ============================================================
   */

  function getCurrentSessionId() {
    return (
      schoolSessionId ||
      sessions.find((x: any) => x.is_current)?.id ||
      ""
    );
  }

  /*
   * ============================================================
   * SAVE CURRENT SUBJECT DRAFT
   * ============================================================
   */

  async function saveAll(
    showMessage = true
  ): Promise<boolean> {
    if (!profile?.school_id) {
      if (showMessage) {
        setMessage(
          "Your school account could not be identified."
        );
      }

      return false;
    }

    const currentSessionId =
      getCurrentSessionId();

    if (!currentSessionId) {
      if (showMessage) {
        setMessage(
          "No academic session has been selected for this school. Please ask the school administrator to select the current session."
        );
      }

      return false;
    }

    if (!classId) {
      if (showMessage) {
        setMessage("Please select a class.");
      }

      return false;
    }

    if (!subjectId) {
      if (showMessage) {
        setMessage("Please select a subject.");
      }

      return false;
    }

    if (!termId) {
      if (showMessage) {
        setMessage("Please select an academic term.");
      }

      return false;
    }

    setSaving(true);

    if (showMessage) {
      setMessage(null);
    }

    try {
      for (const student of students) {
        const score =
          scores[student.id] || {};

        const { error } =
          await saveScore({
            schoolId:
              profile.school_id,

            studentId:
              student.id,

            subjectId,

            classId,

            sessionId:
              currentSessionId,

            termId,

            assignment:
              score.assignment_score === "" ||
              score.assignment_score === null ||
              score.assignment_score === undefined
                ? null
                : Number(score.assignment_score),

            classwork:
              score.classwork_score === "" ||
              score.classwork_score === null ||
              score.classwork_score === undefined
                ? null
                : Number(score.classwork_score),

            ca:
              score.ca_score === "" ||
              score.ca_score === null ||
              score.ca_score === undefined
                ? null
                : Number(score.ca_score),

            exam:
              score.exam_score === "" ||
              score.exam_score === null ||
              score.exam_score === undefined
                ? null
                : Number(score.exam_score),

            teacherComment:
              (score.teacher_comment as string) ||
              "",

            enteredBy:
              profile.id
          });

        if (error) {
          throw error;
        }
      }

      if (showMessage) {
        setMessage(
          "Draft saved successfully."
        );
      }

      return true;
    } catch (error: any) {
      console.error(
        "Save results error:",
        error
      );

      if (showMessage) {
        setMessage(
          error?.message ||
            "Unable to save the result draft."
        );
      }

      return false;
    } finally {
      setSaving(false);
    }
  }

  /*
   * ============================================================
   * VERIFY COMPLETE CLASS RESULTS
   *
   * Every active student must have a result row for EVERY
   * subject assigned to the class.
   * ============================================================
   */

  async function validateCompleteClassResults(): Promise<{
    complete: boolean;
    missing: string[];
  }> {
    if (!classId || !termId) {
      return {
        complete: false,
        missing: [
          "Class or academic term is not selected."
        ]
      };
    }

    const missing: string[] = [];

    try {
      const activeStudents =
        await listStudentsForAttendance(
          classId
        );

      if (
        !activeStudents ||
        activeStudents.length === 0
      ) {
        return {
          complete: false,
          missing: [
            "There are no active students in this class."
          ]
        };
      }

      const classSubjects =
        await listMyResultSubjects(
          classId
        );

      if (
        !classSubjects ||
        classSubjects.length === 0
      ) {
        return {
          complete: false,
          missing: [
            "No subjects are assigned to this class."
          ]
        };
      }

      for (const subject of classSubjects) {
        const results =
          await listResultsForEntry(
            classId,
            subject.id,
            termId
          );

        const resultByStudent =
          new Set(
            (results || []).map(
              (result: ResultScore) =>
                result.student_id
            )
          );

        const missingStudents =
          activeStudents.filter(
            (student: any) =>
              !resultByStudent.has(
                student.id
              )
          );

        if (
          missingStudents.length > 0
        ) {
          const studentNames =
            missingStudents
              .map(
                (student: any) =>
                  student.full_name
              )
              .join(", ");

          missing.push(
            `${subject.name}: ${studentNames}`
          );
        }
      }

      return {
        complete:
          missing.length === 0,
        missing
      };
    } catch (error: any) {
      console.error(
        "Complete result validation error:",
        error
      );

      return {
        complete: false,
        missing: [
          error?.message ||
            "Unable to verify the complete class result."
        ]
      };
    }
  }

  /*
   * ============================================================
   * SUBMIT ENTIRE CLASS
   *
   * IMPORTANT:
   * Do NOT call saveAll() here.
   *
   * Submission is based on the already-saved result rows.
   * The database RPC performs the final completeness check
   * and changes the entire class to "submitted" atomically.
   * ============================================================
   */

  async function handleSubmit() {
    if (!classId || !termId) {
      setMessage(
        "Please select a class and academic term before submitting."
      );

      return;
    }

    setSubmitting(true);
    setMessage(null);

    try {
      /*
       * Verify the complete class BEFORE calling the RPC.
       */
      setMessage(
        "Checking all students and subjects..."
      );

      const validation =
        await validateCompleteClassResults();

      if (!validation.complete) {
        const details =
          validation.missing
            .slice(0, 10)
            .join(" | ");

        throw new Error(
          `Cannot submit the class results because some results are incomplete. ${details}`
        );
      }

      /*
       * The database function performs the final atomic
       * submission of the entire class.
       */
      setMessage(
        "Submitting all class results..."
      );

      const { error } =
        await submitResults(
          classId,
          termId
        );

      if (error) {
        throw error;
      }

      setMessage(
        "All class results have been submitted for principal approval."
      );
    } catch (error: any) {
      console.error(
        "Submit class results error:",
        error
      );

      setMessage(
        error?.message ||
          "Unable to submit the class results for approval."
      );
    } finally {
      setSubmitting(false);
    }
  }

  /*
   * ============================================================
   * UI
   * ============================================================
   */

  return (
    <div className="space-y-4 p-4 sm:p-6">

      <div>
        <h1 className="font-display text-xl font-bold">
          Enter Results
        </h1>

        <p className="text-sm text-slate-500">
          Class teachers prepare complete results for
          every subject assigned to their class.
          Final submission sends the entire class to
          the principal for approval.
        </p>
      </div>

      {loading && (
        <Card className="p-4">
          <p className="text-sm text-slate-500">
            Loading result information...
          </p>
        </Card>
      )}

      <div className="flex flex-wrap gap-2">

        {/* CLASS */}

        <select
          value={classId}
          onChange={(event) => {
            setClassId(
              event.target.value
            );

            setSubjectId("");
            setSubjects([]);
            setStudents([]);
            setScores({});
            setMessage(null);
          }}
          className="rounded-lg border border-slate-300 px-3 py-1.5 text-sm"
        >
          <option value="">
            Class…
          </option>

          {classes.map(
            (classRoom) => (
              <option
                key={classRoom.id}
                value={classRoom.id}
              >
                {classRoom.name}
                {classRoom.arm
                  ? ` ${classRoom.arm}`
                  : ""}
              </option>
            )
          )}
        </select>

        {/* SUBJECT */}

        <select
          value={subjectId}
          onChange={(event) =>
            setSubjectId(
              event.target.value
            )
          }
          disabled={
            !classId ||
            subjects.length === 0
          }
          className="rounded-lg border border-slate-300 px-3 py-1.5 text-sm disabled:bg-slate-100"
        >
          <option value="">
            {classId
              ? subjects.length
                ? "Subject…"
                : "No subjects assigned"
              : "Select class first"}
          </option>

          {subjects.map(
            (subject) => (
              <option
                key={subject.id}
                value={subject.id}
              >
                {subject.name}
              </option>
            )
          )}
        </select>

        {/* TERM */}

        <select
          value={termId}
          onChange={(event) =>
            setTermId(
              event.target.value
            )
          }
          className="rounded-lg border border-slate-300 px-3 py-1.5 text-sm"
        >
          <option value="">
            Term…
          </option>

          {terms.map(
            (term) => (
              <option
                key={term.id}
                value={term.id}
              >
                {term.name}
              </option>
            )
          )}
        </select>
      </div>

      {/* NO CLASSES */}

      {!loading &&
        classes.length === 0 && (
          <Card className="p-4">
            <p className="text-sm text-slate-500">
              No classes are currently assigned
              to you as a class teacher.
            </p>
          </Card>
        )}

      {/* NO SUBJECTS */}

      {!loading &&
        classId &&
        subjects.length === 0 &&
        !message && (
          <Card className="p-4">
            <p className="text-sm text-slate-500">
              No subjects are assigned to this
              class yet.
            </p>
          </Card>
        )}

      {/* STUDENTS / RESULTS */}

      {!loading &&
        students.length > 0 && (
          <Card className="overflow-x-auto p-0">

            <table className="w-full min-w-[720px] text-left text-sm">

              <thead className="border-b border-slate-200 bg-slate-50 text-xs uppercase text-slate-500">

                <tr>

                  <th className="px-3 py-3">
                    Student
                  </th>

                  <th className="px-3 py-3">
                    Assign.
                  </th>

                  <th className="px-3 py-3">
                    Classwork
                  </th>

                  <th className="px-3 py-3">
                    CA
                  </th>

                  <th className="px-3 py-3">
                    Exam
                  </th>

                  <th className="px-3 py-3">
                    Total
                  </th>

                  <th className="px-3 py-3">
                    Comment
                  </th>

                </tr>

              </thead>

              <tbody>

                {students.map(
                  (student) => {
                    const score =
                      scores[
                        student.id
                      ] || {};

                    return (
                      <tr
                        key={
                          student.id
                        }
                        className="border-b border-slate-100 last:border-0"
                      >

                        <td className="px-3 py-2 font-medium">
                          {
                            student.full_name
                          }
                        </td>

                        {(
                          [
                            "assignment_score",
                            "classwork_score",
                            "ca_score",
                            "exam_score"
                          ] as const
                        ).map(
                          (field) => (
                            <td
                              key={
                                field
                              }
                              className="px-3 py-2"
                            >
                              <input
                                type="number"
                                min={0}
                                max={100}
                                value={
                                  (score[
                                    field
                                  ] as number) ??
                                  0
                                }
                                onChange={(
                                  event
                                ) =>
                                  update(
                                    student.id,
                                    field,
                                    event
                                      .target
                                      .value
                                  )
                                }
                                className="w-16 rounded border border-slate-300 px-2 py-1 text-sm"
                              />
                            </td>
                          )
                        )}

                        <td className="px-3 py-2 font-semibold">
                          {total(
                            score
                          )}
                        </td>

                        <td className="px-3 py-2">

                          <input
                            value={
                              (score.teacher_comment as string) ??
                              ""
                            }
                            onChange={(
                              event
                            ) =>
                              update(
                                student.id,
                                "teacher_comment",
                                event
                                  .target
                                  .value
                              )
                            }
                            className="w-32 rounded border border-slate-300 px-2 py-1 text-sm"
                          />

                        </td>

                      </tr>
                    );
                  }
                )}

              </tbody>

            </table>

          </Card>
        )}

      {/* ACTIONS */}

      {!loading &&
        students.length > 0 && (
          <div className="flex flex-wrap items-center gap-3">

            <Button
              variant="secondary"
              onClick={() =>
                saveAll(true)
              }
              loading={saving}
              disabled={
                submitting
              }
            >
              Save draft
            </Button>

            <Button
              onClick={
                handleSubmit
              }
              loading={
                submitting
              }
              disabled={
                saving
              }
            >
              Submit entire class
            </Button>

            {message && (
              <span className="text-sm text-slate-500">
                {message}
              </span>
            )}

          </div>
        )}

      {message &&
        students.length === 0 && (
          <p className="text-sm text-slate-500">
            {message}
          </p>
        )}

    </div>
  );
}
